# Copy to backend/.env and edit. Every key is optional; defaults are in app/config.py.
# All settings use the AIS_ prefix.

# --- Ollama ---------------------------------------------------------------
AIS_OLLAMA_BASE_URL=http://localhost:11434
AIS_CHAT_MODEL=llama3.1:8b
AIS_EMBEDDING_MODEL=nomic-embed-text

# Faster on a laptop without a GPU:
# AIS_CHAT_MODEL=qwen2.5:3b

# --- Server ---------------------------------------------------------------
AIS_HOST=127.0.0.1
AIS_PORT=8000
AIS_LOG_LEVEL=INFO
AIS_CORS_ORIGINS=http://localhost:3000;http://127.0.0.1:3000

# --- Safety ---------------------------------------------------------------
# Semicolon-delimited allow-list of indexable roots. Leave empty to allow any
# local path (fine for a single-user demo, not for a shared deployment).
# AIS_ALLOWED_ROOTS=C:\Users\me\Documents;D:\Shared

# --- Scale / performance --------------------------------------------------
AIS_MAX_FILES_PER_INDEX=20000
AIS_MAX_FILE_SIZE_BYTES=26214400
AIS_EMBEDDING_BATCH_SIZE=32
AIS_CHUNK_SIZE=1200
AIS_CHUNK_OVERLAP=150

# Folder summaries cost one LLM call per folder; lower this on slow hardware.
AIS_SUMMARIZE_FOLDERS=true
AIS_MAX_FOLDER_SUMMARIES=60

# --- Retrieval ------------------------------------------------------------
AIS_RETRIEVAL_TOP_K=8
AIS_RETRIEVAL_FETCH_K=40
AIS_MAX_CHUNKS_PER_FILE=3
AIS_ENABLE_LLM_QUERY_PLANNER=true

# --- Cleanup / filing -----------------------------------------------------
AIS_STALE_DAYS=365
AIS_FILING_CONFIDENCE_THRESHOLD=0.6
